{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "record_type",
    "record_id",
    "revision_id",
    "created_at",
    "interpretation_bundle_id",
    "profile_id",
    "payload",
    "integrity"
  ],
  "properties": {
    "$schema": {
      "const": "https://nomue.ai/id/schema/holm-supplied-p-record/0.3.0-candidate.5"
    },
    "record_type": {
      "const": "nomue-record"
    },
    "record_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
    },
    "revision_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
      "$comment": "RFC 3339 timestamp restricted to UTC with a Z suffix; numeric offsets are rejected. Field ranges are bounded; exact calendar validity (month lengths, leap years) is not fully expressible in a regex and is out of scope for Phase 1."
    },
    "interpretation_bundle_id": {
      "const": "https://nomue.ai/id/bundle/holm-supplied-p-bundle/0.3.0-candidate.5"
    },
    "profile_id": {
      "const": "https://nomue.ai/id/profile/holm-supplied-p-profile/0.3.0-candidate.5"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "inputs", "result", "contract_id"],
      "properties": {
        "declaration": {
          "$ref": "#/$defs/declaration"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "analysis_id", "family_id", "result_id", "members"],
          "properties": {
            "kind": {
              "const": "unissued-holm-envelope-input-v1"
            },
            "analysis_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "family_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "result_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "members": {
              "type": "array",
              "minItems": 3,
              "maxItems": 120,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["member_id", "origin", "p_hex"],
                "properties": {
                  "member_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  },
                  "origin": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["source_id", "hypothesis_id", "sidedness"],
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                      },
                      "hypothesis_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                      },
                      "sidedness": {
                        "enum": ["one_sided", "two_sided"]
                      }
                    }
                  },
                  "p_hex": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  }
                }
              }
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["analysis_id", "family_id", "result_id", "adjusted"],
          "properties": {
            "analysis_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "family_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "result_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "adjusted": {
              "type": "array",
              "minItems": 3,
              "maxItems": 120,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["member_id", "adjusted_hex", "display_hex"],
                "properties": {
                  "member_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  },
                  "adjusted_hex": {
                    "type": "string",
                    "pattern": "^(0|[1-9a-f][0-9a-f]{0,268})$"
                  },
                  "display_hex": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  }
                }
              }
            }
          }
        },
        "contract_id": {
          "const": "https://nomue.ai/id/contract/holm-supplied-p-contract/0.3.0-candidate.5"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization_id", "digest_algorithm", "digest_scope", "content_digest"],
      "properties": {
        "canonicalization_id": {
          "const": "urn:nomue:canonicalization:jcs:0.2.0-draft.1"
        },
        "digest_algorithm": {
          "const": "sha-256"
        },
        "digest_scope": {
          "const": "record_without_integrity"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "declaration": {
