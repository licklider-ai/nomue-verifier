{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nomue:schema:record:0.1.0-draft.1",
  "title": "Phase 1 nomue Record",
  "description": "The Phase 1 minimal Record envelope with the ITGC minimal payload. The surface is closed: undeclared properties are rejected (NRS-CORE-0007). Identifiers are identifiers, not locators (NRS-CORE-0004).",
  "type": "object",
  "required": [
    "$schema",
    "record_type",
    "record_id",
    "revision_id",
    "created_at",
    "interpretation_bundle_id",
    "profile_id",
    "payload",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "urn:nomue:schema:record:0.1.0-draft.1" },
    "record_type": { "const": "nomue-record" },
    "record_id": {
      "$ref": "urn:nomue:schema:common:identifier:0.1.0-draft.1#/$defs/uri"
    },
    "revision_id": {
      "$ref": "urn:nomue:schema:common:identifier:0.1.0-draft.1#/$defs/uri"
    },
    "created_at": {
      "$ref": "urn:nomue:schema:common:identifier:0.1.0-draft.1#/$defs/rfc3339UtcZ"
    },
    "interpretation_bundle_id": {
      "$ref": "urn:nomue:schema:common:identifier:0.1.0-draft.1#/$defs/uri",
      "$comment": "Not a schema constant: an unknown bundle is refused before schema validation (fail closed, NRS-VERSION-0002), which keeps NRS-UNSUPPORTED-BUNDLE distinct from NRS-SCHEMA-INVALID."
    },
    "profile_id": { "const": "urn:nomue:profile:itgc:0.1.0-draft.1" },
    "payload": { "$ref": "urn:nomue:schema:profile:itgc-minimal:0.1.0-draft.1" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "integrity": {
      "type": "object",
      "required": ["canonicalization_id", "digest_algorithm", "digest_scope", "content_digest"],
      "additionalProperties": false,
      "properties": {
        "canonicalization_id": {
          "const": "urn:nomue:canonicalization:jcs:0.2.0-draft.1"
        },
        "digest_algorithm": { "const": "sha-256" },
        "digest_scope": { "const": "record_without_integrity" },
        "content_digest": {
          "$ref": "urn:nomue:schema:common:identifier:0.1.0-draft.1#/$defs/sha256Digest"
        }
      }
    }
  }
}
